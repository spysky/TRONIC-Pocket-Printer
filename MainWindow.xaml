<Window x:Class="TRONIC_Pocket_Printer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TRONIC_Pocket_Printer"
        mc:Ignorable="d"
        Title="TRONIC Pocket Printer" Height="720" Width="900"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ApplicationCommands.Open}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{x:Static ApplicationCommands.Print}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="Open_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.Print}" Executed="Print_Executed" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8" >
            <Button x:Name="BtnOpen" Content="Open" Width="80" Margin="0,0,6,0" Click="BtnOpen_Click" />
            <Button x:Name="BtnPrint" Content="Print" Width="80" Margin="0,0,6,0" Click="BtnPrint_Click" />
            <Button x:Name="BtnFeed" Content="Feed" Width="80" Margin="0,0,6,0" Click="BtnFeed_Click" />
            <Button x:Name="BtnTestPrint" Content="Test Print" Width="90" Margin="0,0,6,0" Click="BtnTestPrint_Click" />
            <Button x:Name="BtnNotes" Content="Notes" Width="80" Margin="0,0,6,0" Click="BtnNotes_Click" />
            <Button x:Name="BtnSettings" Content="Settings" Width="80" Margin="0,0,6,0" Click="BtnSettings_Click" />
            <Button x:Name="BtnDiagnostics" Content="Diagnostics" Width="90" Margin="0,0,6,0" Click="BtnDiagnostics_Click" />
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Margin="0,0,6,0" IsEnabled="False" Click="BtnCancel_Click" />
        </StackPanel>

        <!-- Adjustments -->
        <WrapPanel Grid.Row="1" Margin="8,0,8,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                <TextBlock Text="View:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="CmbViewMode" Width="120" SelectionChanged="Adjustment_Changed">
                    <ComboBoxItem Content="Original" />
                    <ComboBoxItem Content="Print Preview" IsSelected="True" />
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                <TextBlock Text="Orientation:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="CmbOrientation" Width="120" SelectionChanged="Adjustment_Changed">
                    <ComboBoxItem Content="Portrait" IsSelected="True" />
                    <ComboBoxItem Content="Landscape" />
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                <TextBlock Text="Dither:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="CmbDither" Width="130" SelectionChanged="Adjustment_Changed">
                    <ComboBoxItem Content="Threshold" IsSelected="True" />
                    <ComboBoxItem Content="Floyd-Steinberg" />
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                <TextBlock Text="Brightness" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider x:Name="SldBrightness" Width="90" Minimum="-100" Maximum="100" Value="0"
                        VerticalAlignment="Center" Thumb.DragCompleted="Slider_DragCompleted" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                <TextBlock Text="Contrast" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider x:Name="SldContrast" Width="90" Minimum="-100" Maximum="100" Value="0"
                        VerticalAlignment="Center" Thumb.DragCompleted="Slider_DragCompleted" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                <TextBlock Text="Threshold" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider x:Name="SldThreshold" Width="90" Minimum="1" Maximum="254" Value="128"
                        VerticalAlignment="Center" Thumb.DragCompleted="Slider_DragCompleted" />
            </StackPanel>
            <CheckBox x:Name="ChkInvert" Content="Invert" VerticalAlignment="Center" Margin="0,0,12,4" Click="Adjustment_Changed" />
            <CheckBox x:Name="ChkFitWidth" Content="Fit Width" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,4" Click="Adjustment_Changed" />
            <CheckBox x:Name="ChkTrim" Content="Trim Margins" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,4" Click="Adjustment_Changed" />
            <Button Content="Rotate Left" Margin="0,0,6,4" Click="BtnRotateLeft_Click" />
            <Button Content="Rotate Right" Margin="0,0,6,4" Click="BtnRotateRight_Click" />
        </WrapPanel>

        <!-- Preview -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Background="#FF3A3A3A">
            <Image x:Name="ImgPreview" Stretch="None" Margin="10" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </ScrollViewer>

        <!-- PDF navigation + zoom -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,4">
            <Button x:Name="BtnPrevPage" Content="Previous Page" Margin="0,0,6,0" IsEnabled="False" Click="BtnPrevPage_Click" />
            <Button x:Name="BtnNextPage" Content="Next Page" Margin="0,0,6,0" IsEnabled="False" Click="BtnNextPage_Click" />
            <Button x:Name="BtnPrintCurrent" Content="Print Current Page" Margin="0,0,6,0" IsEnabled="False" Click="BtnPrintCurrent_Click" />
            <Button x:Name="BtnPrintAll" Content="Print All Pages" Margin="0,0,6,0" IsEnabled="False" Click="BtnPrintAll_Click" />
            <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="12,0,4,0" />
            <Slider x:Name="SldZoom" Width="120" Minimum="1" Maximum="4" Value="1" VerticalAlignment="Center"
                    ValueChanged="SldZoom_ValueChanged" />
        </StackPanel>

        <!-- Status bar -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="TxtConnection" Text="Disconnected" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="TxtPort" Text="Port: -" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="TxtFile" Text="No file" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="TxtPage" Text="Page: -" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtStatus" Text="Ready" FontWeight="Bold" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
