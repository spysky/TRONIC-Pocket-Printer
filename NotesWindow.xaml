<Window x:Class="TRONIC_Pocket_Printer.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes" Height="600" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Font size:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Slider x:Name="SldFontSize" Width="120" Minimum="14" Maximum="60" Value="26"
                    VerticalAlignment="Center" ValueChanged="Option_Changed" />
            <TextBlock x:Name="TxtFontSize" Text="26" VerticalAlignment="Center" Margin="4,0,16,0" Width="26" />
            <CheckBox x:Name="ChkBold" Content="Bold" VerticalAlignment="Center" Margin="0,0,16,0" Click="Option_Changed" />
            <TextBlock Text="Align:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="CmbAlign" Width="90" SelectionChanged="Option_Changed">
                <ComboBoxItem Content="Left" IsSelected="True" />
                <ComboBoxItem Content="Center" />
                <ComboBoxItem Content="Right" />
            </ComboBox>
        </WrapPanel>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <TextBlock Text="Orientation:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="CmbOrientation" Width="110" SelectionChanged="Option_Changed">
                <ComboBoxItem Content="Portrait" IsSelected="True" />
                <ComboBoxItem Content="Landscape" />
            </ComboBox>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtInput" Grid.Column="0"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Segoe UI" FontSize="14"
                     TextChanged="Option_Changed" />

            <Border Grid.Column="1" Width="220" Margin="10,0,0,0"
                    BorderBrush="Gray" BorderThickness="1" Background="#FF3A3A3A">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Image x:Name="ImgPreview" Stretch="None" Margin="6"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="TxtInfo" Margin="0,8" Foreground="Gray" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnPrint" Content="Print" Width="90" Margin="0,0,6,0" Click="BtnPrint_Click" IsDefault="True" />
            <Button Content="Close" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
