<Window x:Class="TRONIC_Pocket_Printer.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics" Height="560" Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Width="90" Margin="0,0,6,0" Click="BtnRefresh_Click" />
            <Button Content="Test Connection" Width="120" Margin="0,0,6,0" Click="BtnTestConnection_Click" />
            <Button Content="Test Print" Width="90" Margin="0,0,6,0" Click="BtnTestPrint_Click" />
            <Button Content="Feed" Width="90" Margin="0,0,6,0" Click="BtnFeed_Click" />
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="TxtReport" IsReadOnly="True"
                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="TxtBusy" Text="" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Bold" />
            <Button Content="Close" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
